{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/source-catalog-v1.schema.json",
  "title": "SessionReviewer private SourceCatalog record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "session_id", "source_identity", "started_at", "ended_at", "frozen_boundary", "availability", "usage", "project_ids"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "provider": { "$ref": "#/$defs/safe_id" },
    "session_id": { "$ref": "#/$defs/safe_id" },
    "source_identity": { "$ref": "#/$defs/safe_id" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "frozen_boundary": { "$ref": "#/$defs/frozen_boundary" },
    "availability": { "type": "string", "enum": ["available", "source_unavailable"] },
    "usage": { "$ref": "#/$defs/session_usage" },
    "project_ids": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safe_id" }
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frozen_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonl_line", "byte_offset", "source_hash"],
      "properties": {
        "jsonl_line": { "$ref": "#/$defs/nonnegative_integer" },
        "byte_offset": { "$ref": "#/$defs/nonnegative_integer" },
        "source_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "model_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "cached_input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "cache_write_input_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "output_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "reasoning_output_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "total_tokens": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "session_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_ms", "models", "total_tokens"],
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "duration_ms": { "$ref": "#/$defs/nonnegative_integer" },
        "models": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/model_usage" }
        },
        "total_tokens": { "$ref": "#/$defs/nonnegative_integer" }
      }
    }
  }
}
