{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/session-view-v1.schema.json",
  "title": "SessionReviewer private SessionView v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "digest", "project_id", "provider", "session_id", "source_record_digest", "usage_record_digest", "started_at", "ended_at", "terminal_state", "source_availability", "active_revision_ids", "observation_summaries", "observation_chunk_digests", "derived_records", "diagnostics", "dependency_digest", "materializer_version"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "digest": { "$ref": "#/$defs/digest" },
    "project_id": { "$ref": "#/$defs/safe_id" },
    "provider": { "type": "string", "const": "codex" },
    "session_id": { "$ref": "#/$defs/safe_id" },
    "source_record_digest": { "$ref": "#/$defs/digest" },
    "usage_record_digest": { "$ref": "#/$defs/digest" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "terminal_state": { "type": "string", "enum": ["indexed", "unsupported", "missing", "unreadable", "ambiguous"] },
    "source_availability": { "type": "string", "enum": ["available", "source_unavailable"] },
    "active_revision_ids": { "$ref": "#/$defs/digest_set" },
    "observation_summaries": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/observation_summary" }
    },
    "observation_chunk_digests": { "$ref": "#/$defs/digest_set" },
    "derived_records": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/derived_record" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "dependency_digest": { "$ref": "#/$defs/digest" },
    "materializer_version": { "$ref": "#/$defs/safe_id" }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 35, "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bounded_text": { "type": "string", "maxLength": 512, "pattern": "^[^\\r\\n]*$" },
    "nonnegative_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "digest_set": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]{0,63}$": { "type": "string", "maxLength": 512 }
      }
    },
    "observation_fields": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "properties": {
        "artifact_id": { "$ref": "#/$defs/bounded_text" },
        "branch": { "$ref": "#/$defs/bounded_text" },
        "command_signature": { "$ref": "#/$defs/bounded_text" },
        "component": { "$ref": "#/$defs/bounded_text" },
        "duration_ms": { "$ref": "#/$defs/bounded_text" },
        "error_signature": { "$ref": "#/$defs/bounded_text" },
        "exit_code": { "$ref": "#/$defs/bounded_text" },
        "failed": { "$ref": "#/$defs/bounded_text" },
        "file_hash": { "$ref": "#/$defs/bounded_text" },
        "git_head": { "$ref": "#/$defs/bounded_text" },
        "model": { "$ref": "#/$defs/bounded_text" },
        "passed": { "$ref": "#/$defs/bounded_text" },
        "path": { "$ref": "#/$defs/bounded_text" },
        "remote_hash": { "$ref": "#/$defs/bounded_text" },
        "release_id": { "$ref": "#/$defs/bounded_text" },
        "skipped": { "$ref": "#/$defs/bounded_text" },
        "status": { "$ref": "#/$defs/bounded_text" },
        "tag": { "$ref": "#/$defs/bounded_text" },
        "target": { "$ref": "#/$defs/bounded_text" },
        "tool_id": { "$ref": "#/$defs/bounded_text" },
        "version": { "$ref": "#/$defs/bounded_text" }
      }
    },
    "observation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "sequence", "kind", "subject", "occurred_at"],
      "properties": {
        "revision_id": { "$ref": "#/$defs/digest" },
        "sequence": { "$ref": "#/$defs/nonnegative_integer" },
        "kind": { "type": "string", "enum": ["artifact", "branch", "build", "command", "commit", "deployment", "error", "file", "git_status", "lint", "release", "request", "sync", "tag", "test", "tool", "verification", "version"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]*$" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "operation": { "$ref": "#/$defs/bounded_text" },
        "object": { "$ref": "#/$defs/bounded_text" },
        "outcome": { "$ref": "#/$defs/bounded_text" },
        "fields": { "$ref": "#/$defs/observation_fields" },
        "excerpt": { "type": "string", "maxLength": 1024 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/safe_id" },
        "path": { "type": "string", "maxLength": 1024 },
        "detail_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "derived_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subject", "dependency_revision_ids", "rule_id", "rule_version"],
      "properties": {
        "id": { "$ref": "#/$defs/safe_id" },
        "kind": { "$ref": "#/$defs/safe_id" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "dependency_revision_ids": { "$ref": "#/$defs/digest_set" },
        "rule_id": { "$ref": "#/$defs/safe_id" },
        "rule_version": { "$ref": "#/$defs/safe_id" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    }
  }
}
