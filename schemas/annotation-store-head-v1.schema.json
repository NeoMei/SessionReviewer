{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sessionreviewer.local/schemas/annotation-store-head-v1.schema.json",
  "title": "SessionReviewer private annotation store head v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
