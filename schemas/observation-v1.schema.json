{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/observation-v1.schema.json",
  "title": "SessionReviewer private observed revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "revision_id", "source_ref", "timestamp", "adapter_id", "adapter_version"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "key": { "$ref": "#/$defs/observation_key" },
    "revision_id": { "$ref": "#/$defs/digest" },
    "source_ref": { "$ref": "#/$defs/source_ref" },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "operation": { "$ref": "#/$defs/bounded_text" },
    "object": { "$ref": "#/$defs/bounded_text" },
    "outcome": { "$ref": "#/$defs/bounded_text" },
    "fields": { "$ref": "#/$defs/fields" },
    "excerpt": { "type": "string", "maxLength": 1024 },
    "adapter_id": { "$ref": "#/$defs/safe_id" },
    "adapter_version": { "$ref": "#/$defs/safe_id" }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "field_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "bounded_text": { "type": "string", "maxLength": 512, "pattern": "^[^\\r\\n]*$" },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "format": "date-time"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observation_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "source_identity", "sequence", "project_id", "kind", "subject"],
      "properties": {
        "provider": { "type": "string", "const": "codex" },
        "session_id": { "$ref": "#/$defs/safe_id" },
        "source_identity": { "$ref": "#/$defs/safe_id" },
        "sequence": { "$ref": "#/$defs/nonnegative_integer" },
        "project_id": { "$ref": "#/$defs/safe_id" },
        "kind": { "type": "string", "enum": ["artifact", "branch", "build", "command", "commit", "deployment", "error", "file", "git_status", "lint", "release", "request", "sync", "tag", "test", "tool", "verification", "version"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]*$" }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "source_identity", "source_location", "source_hash"],
      "properties": {
        "provider": { "type": "string", "const": "codex" },
        "session_id": { "$ref": "#/$defs/safe_id" },
        "source_identity": { "$ref": "#/$defs/safe_id" },
        "source_location": { "$ref": "#/$defs/source_location" },
        "source_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jsonl"],
      "properties": {
        "kind": { "type": "string", "const": "jsonl" },
        "jsonl": { "$ref": "#/$defs/jsonl_location" }
      }
    },
    "jsonl_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "byte_offset"],
      "properties": {
        "line": { "$ref": "#/$defs/nonnegative_integer" },
        "byte_offset": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "properties": {
        "artifact_id": { "$ref": "#/$defs/bounded_text" },
        "branch": { "$ref": "#/$defs/bounded_text" },
        "command_signature": { "$ref": "#/$defs/bounded_text" },
        "component": { "$ref": "#/$defs/bounded_text" },
        "duration_ms": { "$ref": "#/$defs/bounded_text" },
        "error_signature": { "$ref": "#/$defs/bounded_text" },
        "exit_code": { "$ref": "#/$defs/bounded_text" },
        "failed": { "$ref": "#/$defs/bounded_text" },
        "file_hash": { "$ref": "#/$defs/bounded_text" },
        "git_head": { "$ref": "#/$defs/bounded_text" },
        "model": { "$ref": "#/$defs/bounded_text" },
        "passed": { "$ref": "#/$defs/bounded_text" },
        "path": { "$ref": "#/$defs/bounded_text" },
        "remote_hash": { "$ref": "#/$defs/bounded_text" },
        "release_id": { "$ref": "#/$defs/bounded_text" },
        "skipped": { "$ref": "#/$defs/bounded_text" },
        "status": { "$ref": "#/$defs/bounded_text" },
        "tag": { "$ref": "#/$defs/bounded_text" },
        "target": { "$ref": "#/$defs/bounded_text" },
        "tool_id": { "$ref": "#/$defs/bounded_text" },
        "version": { "$ref": "#/$defs/bounded_text" }
      }
    }
  }
}
