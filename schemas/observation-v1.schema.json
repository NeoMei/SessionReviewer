{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/observation-v1.schema.json",
  "title": "SessionReviewer private observed revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "revision_id", "source_ref", "timestamp", "adapter_id", "adapter_version"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "key": { "$ref": "#/$defs/observation_key" },
    "revision_id": { "$ref": "#/$defs/digest" },
    "source_ref": { "$ref": "#/$defs/source_ref" },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "operation": { "$ref": "#/$defs/bounded_text" },
    "object": { "$ref": "#/$defs/bounded_text" },
    "outcome": { "$ref": "#/$defs/bounded_text" },
    "fields": { "$ref": "#/$defs/fields" },
    "excerpt": { "type": "string", "maxLength": 1024 },
    "adapter_id": { "$ref": "#/$defs/safe_id" },
    "adapter_version": { "$ref": "#/$defs/safe_id" }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "field_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "bounded_text": { "type": "string", "maxLength": 512 },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "format": "date-time"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observation_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "source_identity", "sequence", "project_id", "kind", "subject"],
      "properties": {
        "provider": { "$ref": "#/$defs/safe_id" },
        "session_id": { "$ref": "#/$defs/safe_id" },
        "source_identity": { "$ref": "#/$defs/safe_id" },
        "sequence": { "$ref": "#/$defs/nonnegative_integer" },
        "project_id": { "$ref": "#/$defs/safe_id" },
        "kind": { "$ref": "#/$defs/field_name" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "source_identity", "jsonl_line", "byte_offset", "source_hash"],
      "properties": {
        "provider": { "$ref": "#/$defs/safe_id" },
        "session_id": { "$ref": "#/$defs/safe_id" },
        "source_identity": { "$ref": "#/$defs/safe_id" },
        "jsonl_line": { "$ref": "#/$defs/nonnegative_integer" },
        "byte_offset": { "$ref": "#/$defs/nonnegative_integer" },
        "source_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]{0,63}$": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
