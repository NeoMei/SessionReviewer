{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/review-job-status-v1.schema.json",
  "title": "SessionReviewer public review job status v1",
  "$comment": "This schema is the public CLI and Obsidian-plugin contract. Private job paths, session content, packet/proposal content, prompts, stdout/stderr, source hashes, and internal error text are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "state",
    "attempt",
    "session_index",
    "session_count",
    "accepted_packets",
    "accepted_sessions",
    "can_retry",
    "can_cancel",
    "can_sync_only"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "$ref": "#/$defs/stable_id" },
    "project_id": { "$ref": "#/$defs/stable_id" },
    "state": { "type": "string", "enum": ["idle", "queued", "running", "completed", "failed", "cancel_requested", "cancelled", "retrying"] },
    "phase": { "type": "string", "enum": ["preflight", "scanning", "preparing", "reviewing", "applying", "syncing"] },
    "attempt": { "$ref": "#/$defs/nonnegative_integer" },
    "session_index": { "$ref": "#/$defs/nonnegative_integer" },
    "session_count": { "$ref": "#/$defs/nonnegative_integer" },
    "accepted_packets": { "$ref": "#/$defs/nonnegative_integer" },
    "accepted_sessions": { "$ref": "#/$defs/nonnegative_integer" },
    "error_code": { "type": "string", "enum": ["E_AGENT_UNCONFIGURED", "E_AGENT_INCOMPATIBLE", "E_AGENT_AUTH", "E_AGENT_BUSY", "E_AGENT_TIMEOUT", "E_AGENT_TOOL_FORBIDDEN", "E_AGENT_CANCELLED", "E_PROPOSAL_REJECTED", "E_SESSION_DISCOVERY", "E_APPLY_RECOVERY", "E_SYNC_CONFLICT", "E_SYNC_PARTIAL"] },
    "can_retry": { "type": "boolean" },
    "retry_expected_attempt": { "$ref": "#/$defs/positive_integer" },
    "retry_expected_revision": { "$ref": "#/$defs/positive_integer" },
    "can_cancel": { "type": "boolean" },
    "can_sync_only": { "type": "boolean" },
    "review_usage": { "$ref": "#/$defs/review_usage" }
  },
  "$defs": {
    "stable_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$", "maxLength": 128 },
    "nonnegative_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "review_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_tokens", "pricing_complete"],
      "properties": {
        "total_tokens": { "$ref": "#/$defs/nonnegative_integer" },
        "total_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "pricing_complete": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "pricing_complete": { "const": true } },
            "required": ["pricing_complete"]
          },
          "then": {
            "properties": { "total_cost_usd": { "type": "number", "minimum": 0 } },
            "required": ["total_cost_usd"]
          },
          "else": {
            "properties": { "total_cost_usd": { "type": "null" } }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "can_retry": { "const": true } },
        "required": ["can_retry"]
      },
      "then": {
        "required": ["retry_expected_attempt", "retry_expected_revision"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["retry_expected_attempt"] },
            { "required": ["retry_expected_revision"] }
          ]
        }
      }
    }
  ]
}
