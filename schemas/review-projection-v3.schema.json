{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/review-projection-v3.schema.json",
  "title": "SessionReviewer public review projection v3",
  "$comment": "Structural schema for the machine projection. The Go ParseMachineLedgerV3 and LoadV3 APIs additionally reject duplicate JSON keys, unknown fields at every level, missing arrays, invalid patch operations, duplicate patch/baseline identities, unsafe accounting, cross-file project/generation/hash mismatches, and writers below 0.3.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minimum_writer_version",
    "project_id",
    "generation_id",
    "project_view_digest",
    "accepted_revision",
    "review_sha256",
    "history_sha256",
    "accounting",
    "sessions",
    "human_patches",
    "orphan_patches",
    "generated_baselines",
    "legacy_compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "minimum_writer_version": {
      "const": "0.3.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "$ref": "#/$defs/generation_id"
    },
    "project_view_digest": {
      "$ref": "#/$defs/lowercase_sha256"
    },
    "accepted_revision": {
      "type": "integer",
      "minimum": 0
    },
    "review_sha256": {
      "$ref": "#/$defs/lowercase_sha256"
    },
    "history_sha256": {
      "$ref": "#/$defs/lowercase_sha256"
    },
    "last_successful_sync": {
      "type": "string"
    },
    "accounting": {
      "$ref": "#/$defs/project_summary"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session_report"
      }
    },
    "human_patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/human_patch"
      }
    },
    "orphan_patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/human_patch"
      }
    },
    "generated_baselines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generated_baseline"
      }
    },
    "legacy_compatibility": {
      "$ref": "#/$defs/legacy_compatibility"
    }
  },
  "$defs": {
    "legacy_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "timeline",
        "decisions",
        "open_loops",
        "current_risks"
      ],
      "properties": {
        "current_state": {
          "$ref": "#/$defs/current_state"
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timeline_event"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "open_loops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/open_loop"
          }
        },
        "current_risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/current_risk_provenance"
          }
        }
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "revision",
        "goal",
        "last_verified",
        "branch",
        "uncommitted_changes",
        "blockers",
        "open_risks",
        "next_action",
        "first_inspection",
        "last_updated",
        "source_sessions",
        "evidence"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "goal": {
          "type": "string"
        },
        "last_verified": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "uncommitted_changes": {
          "$ref": "#/$defs/string_array"
        },
        "blockers": {
          "$ref": "#/$defs/string_array"
        },
        "open_risks": {
          "$ref": "#/$defs/string_array"
        },
        "next_action": {
          "type": "string"
        },
        "first_inspection": {
          "type": "string"
        },
        "last_updated": {
          "type": "string"
        },
        "source_sessions": {
          "$ref": "#/$defs/string_array"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "timeline_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurred_at",
        "revision",
        "class",
        "title",
        "summary",
        "evidence",
        "decision_ids",
        "open_loop_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "class": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "decision_ids": {
          "$ref": "#/$defs/string_array"
        },
        "open_loop_ids": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "title",
        "status",
        "revision",
        "tags",
        "supersedes",
        "source_sessions",
        "evidence",
        "context",
        "rationale",
        "consequences",
        "reevaluate_when",
        "alternatives",
        "rejected_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "supersedes": {
          "$ref": "#/$defs/string_array"
        },
        "source_sessions": {
          "$ref": "#/$defs/string_array"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "context": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "consequences": {
          "type": "string"
        },
        "reevaluate_when": {
          "type": "string"
        },
        "alternatives": {
          "$ref": "#/$defs/string_array"
        },
        "rejected_paths": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "open_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "title",
        "status",
        "revision",
        "tags",
        "source_sessions",
        "evidence",
        "question",
        "attempts",
        "blocker",
        "next_experiment",
        "completion_criterion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "source_sessions": {
          "$ref": "#/$defs/string_array"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "question": {
          "type": "string"
        },
        "attempts": {
          "$ref": "#/$defs/string_array"
        },
        "blocker": {
          "type": "string"
        },
        "next_experiment": {
          "type": "string"
        },
        "completion_criterion": {
          "type": "string"
        }
      }
    },
    "current_risk_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "kind",
        "source_key"
      ],
      "properties": {
        "risk_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "blocker",
            "open_risk"
          ]
        },
        "source_key": {
          "$ref": "#/$defs/lowercase_sha256"
        }
      }
    },
    "lowercase_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "session_id",
        "jsonl_line",
        "source_hash",
        "summary"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "jsonl_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_hash": {
          "$ref": "#/$defs/lowercase_sha256"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "project_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_duration_ms",
        "total_tokens",
        "total_cost_usd",
        "models"
      ],
      "properties": {
        "total_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project_model_summary"
          }
        }
      }
    },
    "project_model_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "total_tokens",
        "total_cost_usd",
        "token_share_pct",
        "cost_share_pct"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "token_share_pct": {
          "type": "number",
          "minimum": 0
        },
        "cost_share_pct": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "session_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "session_id",
        "revision",
        "initial_goal",
        "goal_changes",
        "phases",
        "files",
        "commits",
        "verification",
        "decisions_added",
        "decisions_revised",
        "open_loops_created",
        "open_loops_closed",
        "previous_session_id",
        "next_session_id",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "initial_goal": {
          "type": "string"
        },
        "goal_changes": {
          "$ref": "#/$defs/string_array"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session_phase"
          }
        },
        "files": {
          "$ref": "#/$defs/string_array"
        },
        "commits": {
          "$ref": "#/$defs/string_array"
        },
        "verification": {
          "$ref": "#/$defs/string_array"
        },
        "decisions_added": {
          "$ref": "#/$defs/string_array"
        },
        "decisions_revised": {
          "$ref": "#/$defs/string_array"
        },
        "open_loops_created": {
          "$ref": "#/$defs/string_array"
        },
        "open_loops_closed": {
          "$ref": "#/$defs/string_array"
        },
        "previous_session_id": {
          "type": "string"
        },
        "next_session_id": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "accounting": {
          "$ref": "#/$defs/session_accounting"
        }
      }
    },
    "session_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "session_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "duration_ms",
        "models",
        "total_tokens",
        "total_cost_usd"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_accounting"
          }
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "model_accounting": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pricing": {
                "$ref": "#/$defs/unknown_pricing"
              }
            },
            "required": [
              "pricing"
            ]
          },
          "then": {
            "properties": {
              "cost_usd": {
                "const": 0
              }
            }
          }
        }
      ],
      "required": [
        "model",
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens",
        "pricing",
        "cost_usd"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pricing": {
      "oneOf": [
        {
          "$ref": "#/$defs/trusted_pricing"
        },
        {
          "$ref": "#/$defs/unknown_pricing"
        }
      ]
    },
    "trusted_pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "input_per_million",
        "cached_input_per_million",
        "cache_write_input_per_million",
        "output_per_million",
        "source",
        "as_of"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "input_per_million": {
          "type": "number",
          "minimum": 0
        },
        "cached_input_per_million": {
          "type": "number",
          "minimum": 0
        },
        "cache_write_input_per_million": {
          "type": "number",
          "minimum": 0
        },
        "output_per_million": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "unknown_pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "input_per_million",
        "cached_input_per_million",
        "cache_write_input_per_million",
        "output_per_million",
        "source",
        "as_of"
      ],
      "properties": {
        "currency": {
          "const": ""
        },
        "input_per_million": {
          "const": 0
        },
        "cached_input_per_million": {
          "const": 0
        },
        "cache_write_input_per_million": {
          "const": 0
        },
        "output_per_million": {
          "const": 0
        },
        "source": {
          "const": ""
        },
        "as_of": {
          "const": ""
        }
      }
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generation_id": {
      "type": "string",
      "pattern": "^generation-[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "human_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "field",
        "operation",
        "base_generated_hash"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "set",
            "suppress",
            "restore_default"
          ]
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_generated_hash": {
          "$ref": "#/$defs/lowercase_sha256"
        }
      }
    },
    "generated_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "entity_id",
        "field",
        "kind",
        "generated_hash"
      ],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/generation_id"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["scalar", "list"]
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_hash": {
          "$ref": "#/$defs/lowercase_sha256"
        }
      }
    }
  }
}
