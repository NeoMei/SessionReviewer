{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/review-projection-v3.schema.json",
  "title": "SessionReviewer public review projection v3",
  "$comment": "Structural schema for the machine projection. The Go ParseMachineLedgerV3 and LoadV3 APIs additionally reject duplicate JSON keys, unknown fields at every level, missing arrays, invalid patch operations, duplicate patch/baseline identities, unsafe accounting, cross-file project/generation/hash mismatches, and writers below 0.3.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minimum_writer_version",
    "project_id",
    "generation_id",
    "project_view_digest",
    "accepted_revision",
    "review_sha256",
    "history_sha256",
    "accounting",
    "sessions",
    "human_patches",
    "generated_baselines",
    "legacy_compatibility"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "minimum_writer_version": { "const": "0.3.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "generation_id": { "$ref": "#/$defs/generation_id" },
    "project_view_digest": { "$ref": "#/$defs/lowercase_sha256" },
    "accepted_revision": { "type": "integer", "minimum": 0 },
    "review_sha256": { "$ref": "#/$defs/lowercase_sha256" },
    "history_sha256": { "$ref": "#/$defs/lowercase_sha256" },
    "last_successful_sync": { "type": "string" },
    "accounting": { "$ref": "review-ledger-v2.schema.json#/$defs/project_summary" },
    "sessions": { "type": "array", "items": { "$ref": "review-ledger-v2.schema.json#/$defs/session_report" } },
    "human_patches": { "type": "array", "items": { "$ref": "#/$defs/human_patch" } },
    "generated_baselines": { "type": "array", "items": { "$ref": "#/$defs/generated_baseline" } },
    "legacy_compatibility": { "$ref": "review-ledger-v2.schema.json#/$defs/legacy_compatibility" }
  },
  "$defs": {
    "generation_id": { "type": "string", "pattern": "^generation-[a-z0-9][a-z0-9._-]{0,127}$" },
    "lowercase_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "human_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "field", "operation", "base_generated_hash"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["set", "suppress", "restore_default"] },
        "value": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "base_generated_hash": { "$ref": "#/$defs/lowercase_sha256" }
      }
    },
    "generated_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "entity_id", "field", "generated_hash"],
      "properties": {
        "generation_id": { "$ref": "#/$defs/generation_id" },
        "entity_id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "generated_hash": { "$ref": "#/$defs/lowercase_sha256" }
      }
    }
  }
}
