{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/project-view-v1.schema.json",
  "title": "SessionReviewer private ProjectView v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "digest", "project_id", "generation", "started_at", "ended_at", "source_sessions", "terminal_counts", "session_view_dependencies", "observation_revision_ids", "probe_state_digest", "live_state", "witnessed_state", "derived_records", "aggregation_coverage", "associated_usage", "dependency_digest", "reducer_version"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "digest": { "$ref": "#/$defs/digest" },
    "project_id": { "$ref": "#/$defs/safe_id" },
    "generation": { "$ref": "#/$defs/positive_integer" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "ended_at": { "$ref": "#/$defs/timestamp" },
    "source_sessions": { "$ref": "#/$defs/nonnegative_integer" },
    "terminal_counts": { "$ref": "#/$defs/terminal_counts" },
    "session_view_dependencies": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/session_view_dependency" }
    },
    "observation_revision_ids": { "$ref": "#/$defs/digest_set" },
    "probe_state_digest": { "$ref": "#/$defs/digest" },
    "live_state": { "$ref": "#/$defs/state_snapshot" },
    "witnessed_state": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/derived_record" }
    },
    "derived_records": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/derived_record" }
    },
    "aggregation_coverage": { "$ref": "#/$defs/aggregation_coverage" },
    "associated_usage": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/associated_usage" }
    },
    "previous_view_digest": { "$ref": "#/$defs/digest" },
    "dependency_digest": { "$ref": "#/$defs/digest" },
    "reducer_version": { "$ref": "#/$defs/safe_id" }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 35, "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonnegative_integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest_set": {
      "type": "array",
      "maxItems": 65536,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]{0,63}$": { "type": "string", "maxLength": 512 }
      }
    },
    "terminal_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indexed", "unsupported", "missing", "unreadable", "ambiguous"],
      "properties": {
        "indexed": { "$ref": "#/$defs/nonnegative_integer" },
        "unsupported": { "$ref": "#/$defs/nonnegative_integer" },
        "missing": { "$ref": "#/$defs/nonnegative_integer" },
        "unreadable": { "$ref": "#/$defs/nonnegative_integer" },
        "ambiguous": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "aggregation_channel_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seen", "emitted", "collapsed", "dropped", "evicted", "truncated"],
      "properties": {
        "seen": { "$ref": "#/$defs/nonnegative_integer" },
        "emitted": { "$ref": "#/$defs/nonnegative_integer" },
        "collapsed": { "$ref": "#/$defs/nonnegative_integer" },
        "dropped": { "$ref": "#/$defs/nonnegative_integer" },
        "evicted": { "$ref": "#/$defs/nonnegative_integer" },
        "truncated": { "type": "boolean" }
      }
    },
    "aggregation_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_summaries_seen", "witnessed_keys", "session_recoveries", "cross_session_recoveries", "phase_boundaries", "module_candidates", "event_references", "selected_evidence_revisions"],
      "properties": {
        "observation_summaries_seen": { "$ref": "#/$defs/nonnegative_integer" },
        "witnessed_keys": { "$ref": "#/$defs/aggregation_channel_coverage" },
        "session_recoveries": { "$ref": "#/$defs/aggregation_channel_coverage" },
        "cross_session_recoveries": { "$ref": "#/$defs/aggregation_channel_coverage" },
        "phase_boundaries": { "$ref": "#/$defs/aggregation_channel_coverage" },
        "module_candidates": { "$ref": "#/$defs/aggregation_channel_coverage" },
        "event_references": { "$ref": "#/$defs/aggregation_channel_coverage" },
        "selected_evidence_revisions": { "$ref": "#/$defs/aggregation_channel_coverage" }
      }
    },
    "session_view_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "digest"],
      "properties": {
        "provider": { "type": "string", "const": "codex" },
        "session_id": { "$ref": "#/$defs/safe_id" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "state_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dirty_path_count"],
      "properties": {
        "branch": { "type": "string", "maxLength": 512 },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "dirty_path_count": { "$ref": "#/$defs/nonnegative_integer" }
      }
    },
    "derived_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subject", "dependency_revision_ids", "rule_id", "rule_version"],
      "properties": {
        "id": { "$ref": "#/$defs/safe_id" },
        "kind": { "$ref": "#/$defs/safe_id" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "dependency_revision_ids": { "$ref": "#/$defs/digest_set" },
        "rule_id": { "$ref": "#/$defs/safe_id" },
        "rule_version": { "$ref": "#/$defs/safe_id" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "associated_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "usage_record_digest", "shared"],
      "properties": {
        "provider": { "type": "string", "const": "codex" },
        "session_id": { "$ref": "#/$defs/safe_id" },
        "usage_record_digest": { "$ref": "#/$defs/digest" },
        "shared": { "type": "boolean" }
      }
    }
  }
}
