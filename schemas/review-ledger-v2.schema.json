{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neomei/SessionReviewer/schemas/review-ledger-v2.schema.json",
  "title": "SessionReviewer machine ledger v2",
  "$comment": "JSON Schema validates structural shape. The Go ParseMachineLedger and Validate APIs additionally reject duplicate JSON object keys and enforce cross-item identity uniqueness, evidence owner and source-session existence, entity-reference closure, and one reciprocal acyclic session chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "accepted_revision",
    "review_sha256",
    "history_sha256",
    "accounting",
    "sessions",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "project_id": { "type": "string", "minLength": 1 },
    "accepted_revision": { "type": "integer", "minimum": 0 },
    "review_sha256": { "$ref": "#/$defs/lowercase_sha256" },
    "history_sha256": { "$ref": "#/$defs/lowercase_sha256" },
    "last_successful_sync": { "type": "string" },
    "accounting": { "$ref": "#/$defs/project_summary" },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session_report" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_entry" }
    }
  },
  "$defs": {
    "lowercase_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "session_id", "jsonl_line", "source_hash", "summary"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "jsonl_line": { "type": "integer", "minimum": 1 },
        "source_hash": { "$ref": "#/$defs/lowercase_sha256" },
        "summary": { "type": "string" }
      }
    },
    "project_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_duration_ms", "total_tokens", "total_cost_usd", "models"],
      "properties": {
        "total_duration_ms": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/project_model_summary" }
        }
      }
    },
    "project_model_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "total_tokens", "total_cost_usd", "token_share_pct", "cost_share_pct"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "token_share_pct": { "type": "number", "minimum": 0 },
        "cost_share_pct": { "type": "number", "minimum": 0 }
      }
    },
    "session_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "project_id", "session_id", "revision", "initial_goal", "goal_changes",
        "phases", "files", "commits", "verification", "decisions_added", "decisions_revised",
        "open_loops_created", "open_loops_closed", "previous_session_id", "next_session_id", "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "initial_goal": { "type": "string" },
        "goal_changes": { "$ref": "#/$defs/string_array" },
        "phases": {
          "type": "array",
          "items": { "$ref": "#/$defs/session_phase" }
        },
        "files": { "$ref": "#/$defs/string_array" },
        "commits": { "$ref": "#/$defs/string_array" },
        "verification": { "$ref": "#/$defs/string_array" },
        "decisions_added": { "$ref": "#/$defs/string_array" },
        "decisions_revised": { "$ref": "#/$defs/string_array" },
        "open_loops_created": { "$ref": "#/$defs/string_array" },
        "open_loops_closed": { "$ref": "#/$defs/string_array" },
        "previous_session_id": { "type": "string" },
        "next_session_id": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "accounting": { "$ref": "#/$defs/session_accounting" }
      }
    },
    "session_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "evidence"],
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    },
    "session_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_ms", "models", "total_tokens", "total_cost_usd"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/model_accounting" }
        },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "model_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model", "input_tokens", "cached_input_tokens", "cache_write_input_tokens",
        "output_tokens", "reasoning_output_tokens", "total_tokens", "pricing", "cost_usd"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "pricing": { "$ref": "#/$defs/pricing" },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency", "input_per_million", "cached_input_per_million", "cache_write_input_per_million",
        "output_per_million", "source", "as_of"
      ],
      "properties": {
        "currency": { "const": "USD" },
        "input_per_million": { "type": "number", "minimum": 0 },
        "cached_input_per_million": { "type": "number", "minimum": 0 },
        "cache_write_input_per_million": { "type": "number", "minimum": 0 },
        "output_per_million": { "type": "number", "minimum": 0 },
        "source": { "type": "string", "format": "uri" },
        "as_of": { "type": "string", "format": "date" }
      }
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
